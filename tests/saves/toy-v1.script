# Script for tests/saves/toy-v1.wssave (save format 1). It exercises both
# simulation levels and a rejected command. The building IDs are those of
# seed 2026 in the toy dataset (version 1). Regenerate only for an
# intentional format change, keeping the old file as a migration fixture:
#   cd core && cargo run --release -p ws-cli -- save --seed 2026 --ticks 600 \
#     --script ../tests/saves/toy-v1.script --out ../tests/saves/toy-v1.wssave
noop
scale 10
flush
step 100
lod 9223372036854775809 2        # unknown valid ID: a journaled rejection
lod 5094847613373147266 2
lod 6440075434426058248 2
flush
step 150
lod 5094847613373147266 1
flush
step 100
lod 8906142576354433264 2
flush
step 50
